{
  "name": "Stock Monitor (Next.js + FastAPI)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss"
      ]
    }
    
  },
  "updateContentCommand": "cd backend && pip3 install --user -r requirements.txt && cd ../frontend && npm ci",
  "postAttachCommand": {
    "backend": "cd backend && uvicorn src.main:app --reload --port 8000",
    "frontend": "cd frontend && npm run dev"
  },
  "portsAttributes": {
    "3000": { "label": "Frontend (Next.js)", "onAutoForward": "openPreview" },
    "8000": { "label": "Backend (FastAPI)", "onAutoForward": "silent" }
  },
  "forwardPorts": [3000, 8000]
}